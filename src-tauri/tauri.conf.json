{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xore",
  "version": "1.0.0",
  "identifier": "net.xore.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "xore.net",
    "longDescription": "xore.net · pick a core, make ur page, chat, call, play",
    "category": "SocialNetworking",
    "publisher": "xore",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}